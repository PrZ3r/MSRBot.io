{{>header}}
  <!-- Main content starts - do not edit above this line -->

  <main class="container my-3">
    <div class="card mb-3">
      <div class="card-header d-flex align-items-center">
        <h1 class="h4 mb-0">Document Suites and Collections</h1>
      </div>
      <div class="card-body">
        <span class="text-muted small">
          Bundles of related standards with multiple parts (e.g. SMPTE 379, SMPTE 2110, ISO 11664).
          <br>
          <span class="fst-italic">
            Note: this page and each suite page automatically shows the latest versions of all documents.
          </span>
        </span>

        <div class="row g-2 align-items-end mt-3">
          <div class="col-md-6">
            <label for="suiteSearch" class="form-label small fw-semibold">Filter suites</label>
            <input
              type="search"
              id="suiteSearch"
              class="form-control form-control-sm"
              placeholder="Search by publisher or number…"
            />
          </div>
          <div class="col-md-4 col-lg-3">
            <div class="input-group input-group-sm w-100" aria-label="Filter by publisher">
              <span class="input-group-text">Publisher</span>
              <select id="suitePublisherFilter" class="form-select">
                <option value="">All publishers</option>
              </select>
            </div>
          </div>
          <div class="col-md-4 col-lg-3">
            <div class="input-group input-group-sm w-100" aria-label="Filter by kind">
              <span class="input-group-text">Type</span>
              <select id="suiteKindFilter" class="form-select">
                <option value="">Both</option>
                <option value="suite">Suites</option>
                <option value="collection">Collections</option>
              </select>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div id="suite-list" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">  
      <!-- suitesIndex.js will inject cards here -->
    </div>
  </main>

  <!-- suite index page scripts -->
  <script src="{{assetPrefix}}js/suitesIndex.js"></script>

  <!-- Main content ends - do not edit below this line -->
{{>footer}}