{{>header}}
  <!-- Main content starts - do not edit above this line -->


  <main class="container my-4">
    <section id="portal-header" class="mb-3">
      <h1 id="portal-title" class="h3 mb-1">{{portalTitle}}</h1>
      <p id="portal-summary" class="text-muted mb-0">{{portalSummary}}</p>
    </section>

    <!-- Sticky topbar: use same card pattern as suites/refTree topbars -->
    <div id="portal-topbar" class="sticky-top mb-3 px-3 py-2">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <nav aria-label="Portal sections" class="small d-flex flex-wrap align-items-center gap-2">
            {{#each portalNav}}
              {{#unless @first}}<span class="text-muted">·</span>{{/unless}}
              <a href="#{{id}}" class="text-decoration-none">{{label}}</a>
            {{/each}}
          </nav>
          <span id="portal-doc-count" class="text-muted small text-nowrap">{{#if portalDocCount}}Showing {{portalDocCount}} / {{portalDocCount}} docs{{/if}}</span>
        </div>
        {{#if portalDocCount}}
        <div id="portal-doc-controls" class="card-body">
          <div class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
              <label for="portalDocSearch" class="form-label small fw-semibold">Filter docs</label>
              <input id="portalDocSearch" class="form-control form-control-sm" type="search" placeholder="Search docs (label, title, abstract, etc.)" />
            </div>
            <div class="col-12 col-md-3">
              <div class="input-group input-group-sm w-100" aria-label="Filter by type">
                <span class="input-group-text">Type</span>
                <select id="portalTypeFilter" class="form-select">
                  <option value="">All types</option>
                  {{{portalTypeOptions}}}
                </select>
              </div>
            </div>
            <div class="col-12 col-md-2">
              <div class="input-group input-group-sm w-100" aria-label="Filter by publisher">
                <span class="input-group-text">Publisher</span>
                <select id="portalPublisherFilter" class="form-select">
                  <option value="">All publishers</option>
                  {{{portalPublisherOptions}}}
                </select>
              </div>
            </div>
            <div class="col-12 col-md-2">
              <div class="input-group input-group-sm w-100" aria-label="Sort">
                <span class="input-group-text">Sort</span>
                <select id="portalSort" class="form-select">
                  <option value="label:asc">Label (A-Z)</option>
                  <option value="label:desc">Label (Z-A)</option>
                  <option value="title:asc">Title (A-Z)</option>
                  <option value="title:desc">Title (Z-A)</option>
                  <option value="doctype:asc">Type (A-Z)</option>
                  <option value="doctype:desc">Type (Z-A)</option>
                  <option value="published:desc">Latest</option>
                  <option value="published:asc">Oldest</option>
                  <option value="status:asc">Status (A-Z)</option>
                  <option value="status:desc">Status (Z-A)</option>
                  <option value="publisher:asc">Publisher (A-Z)</option>
                  <option value="publisher:desc">Publisher (Z-A)</option>
                </select>
              </div>
            </div>
          </div>
        </div>
        {{/if}}
      </div>
    </div>

    {{#if portalSectionsHtml}}
    <section id="portal-overview" class="mb-4">{{{portalSectionsHtml}}}</section>
    {{/if}}

    <section id="portal-docs" class="mb-4">
      <div id="portal-docs-table">
        {{#if portalDocCount}}
        <h3>Documents</h3>
        <div class="card">
          <div class="table-responsive">
            <table class="table table-sm mb-0 suite-table">
              <thead class="table-header"><tr><th>Label</th><th>Document</th><th>Type</th><th>Date</th><th class="status-col">Status</th><th>Publisher</th></tr></thead>
              <tbody class="table-body" id="portal-docs-body">
                {{{portalRowsHtml}}}
              </tbody>
            </table>
          </div>
        </div>
        <p id="portal-docs-empty" class="text-muted small mt-2 d-none">No documents match these filters.</p>
        {{else}}
        <h2>Documents</h2><p>No documents matched this portal yet.</p>
        {{/if}}
      </div>
    </section>

    {{#if portalResourcesHtml}}
    <section id="portal-resources" class="mb-4">{{{portalResourcesHtml}}}</section>
    {{/if}}
  </main>


  <!-- portal page scripts -->
  <script src="{{assetPrefix}}js/portals.js"></script>

  <!-- Main content ends - do not edit below this line -->
{{>footer}}