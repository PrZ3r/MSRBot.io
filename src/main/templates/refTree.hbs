  {{>header}}
    <!-- Main content starts - do not edit above this line -->

    <main class="container my-4">
      <header class="mb-3">
        <div class="d-flex justify-content-between align-items-start">
          <div class="gap-2">
            <p class="text-muted mb-1">
              Current document root:
              <span class="ms-1 fs-6"><code>{{docRootLabel}}</code></span>
            </p>
            <p class="h5 mb-2">
              <a class="text-decoration-none"  href="../../docs/{{docId}}/">{{docRootTitle}}</a>
            </p>
            {{#if publisher}}
              <p class="text-muted small mb-0">
                <a class="" href="../../docs/?f.publisher={{publisher}}">{{publisher}}</a> • <a class="" href="../../docs/?f.docType={{docType}}">{{docType}}</a> • [{{getStatus docId}}] {{{getstatusButton docId "10"}}}
                {{#with (docProjLookup @root.docProjs docId)}}
                  {{#ifnoteq projectStatus "Complete"}}
                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="#F6BE00" class="bi bi-slash-circle-fill align-baseline" viewBox="0 0 16 16">
                      <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-4.646-2.646a.5.5 0 0 0-.708-.708l-6 6a.5.5 0 0 0 .708.708l6-6z"/>
                    </svg>
                  {{/ifnoteq}}
                {{/with}}
              </p>
            {{/if}}
          </div>
          <div class="text-end">
            <a class="btn btn-outline-secondary btn-sm ms-2 mb-2 text-nowrap" href="../../docs/{{docId}}/">
              ← Back to Doc
            </a>
            <div class="small text-muted text-nowrap">
              <label for="rt-depth-select">Max Ref Depth:</label>
              <select id="rt-depth-select" class="form-select form-select-sm d-inline w-auto ms-1">
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3" selected>3</option>
              </select>
            </div>
          </div>
        </div>
        <p class="small text-muted mt-2 mb-0">Click a document below to open its own reference tree.</p>
      </header>

      <div id="rt-graph-note" class="alert alert-warning small d-none" role="status"></div>

      <!-- Reference panels row: upstream and downstream side-by-side -->
      <section class="row g-3">
        <div class="col-lg-6">
          <div class="card h-100">
            <div class="card-header">
              <h2 class="h6 mb-0"><i class="bi bi-arrow-up-left"></i> Referenced By</h2>
              <div class="small text-muted">Docs that depend on <a href="../../docs/{{docId}}/">{{getLabel docId}}</a></div>
              <div class="small d-flex justify-content-between align-items-center flex-wrap gap-1">
                <span>
                  <span class="text-muted">View:</span>
                  <button type="button"
                          class="btn btn-link btn-sm p-0 rt-view-toggle fw-semibold"
                          data-panel="up"
                          data-view="levels">
                    Simple
                  </button>
                  <span class="text-muted">·</span>
                  <button type="button"
                          class="btn btn-link btn-sm p-0 rt-view-toggle"
                          data-panel="up"
                          data-view="routes">
                    Expanded
                  </button>
                </span>
                <span class="rt-collapse-controls d-none" data-panel="up">
                  <span class="text-muted">Tree:</span>
                  <button type="button"
                          class="btn btn-link btn-sm p-0 rt-collapse-toggle"
                          data-panel="up"
                          data-action="collapse">
                    Collapse all
                  </button>
                  <span class="text-muted">·</span>
                  <button type="button"
                          class="btn btn-link btn-sm p-0 rt-collapse-toggle"
                          data-panel="up"
                          data-action="expand">
                    Expand all
                  </button>
                </span>
              </div>
            </div>
            <div id="rt-upstream" class="card-body small">{{{upHtml}}}</div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="card h-100">
            <div class="card-header">
              <h2 class="h6 mb-0">References Of <i class="bi bi-arrow-down-right"></i></h2>
              <div class="small text-muted">Docs that <a href="../../docs/{{docId}}/">{{getLabel docId}}</a> depend on</div>
              <div class="small d-flex justify-content-between align-items-center flex-wrap gap-1">
                <span>
                  <span class="text-muted">View:</span>
                  <button type="button"
                          class="btn btn-link btn-sm p-0 rt-view-toggle fw-semibold"
                          data-panel="down"
                          data-view="levels">
                    Simple
                  </button>
                  <span class="text-muted">·</span>
                  <button type="button"
                          class="btn btn-link btn-sm p-0 rt-view-toggle"
                          data-panel="down"
                          data-view="routes">
                    Expanded
                  </button>
                </span>
                <span class="rt-collapse-controls d-none" data-panel="down">
                  <span class="text-muted">Tree:</span>
                  <button type="button"
                          class="btn btn-link btn-sm p-0 rt-collapse-toggle"
                          data-panel="down"
                          data-action="collapse">
                    Collapse all
                  </button>
                  <span class="text-muted">·</span>
                  <button type="button"
                          class="btn btn-link btn-sm p-0 rt-collapse-toggle"
                          data-panel="down"
                          data-action="expand">
                    Expand all
                  </button>
                </span>
              </div>
            </div>
            <div id="rt-downstream" class="card-body small">{{{downHtml}}}</div>
          </div>
        </div>
      </section>

    </main>

    <script>
      window.assetPrefix = "{{assetPrefix}}";
      window.MSR_REF_ROOT = "{{docId}}";
    </script>
    <script src="{{assetPrefix}}js/refTreeRender.js"></script>
    <script src="{{assetPrefix}}js/refTree.js"></script>

    <!-- Main content ends - do not edit below this line -->
{{>footer}}